# -----------------------------------------------------------------------------
# Run tests (required to clone and run Playwright)
# Copy this file to `.env` at the project root. Never commit `.env`.
# -----------------------------------------------------------------------------

# Base URL for Didaxis (Playwright `baseURL` and navigation).
DIDAXIS_URL=https://test.didaxis.studio

# Primary test account used by `tests/auth.setup.ts` and most specs.
DIDAXIS_EMAIL=your-user@example.com

# Password for the primary test account. Use a dedicated test user, not production credentials.
DIDAXIS_PASSWORD=your-password-here

# Bearer token for API cleanup (`DELETE /api/programs/...`). Refresh from the app after login if expired.
DIDAXIS_API_TOKEN=your-api-bearer-token

# Optional: second account for permission / non-admin probes (some specs still read DIDAXIS_NON_ADMIN_*).
DIDAXIS_ALT_EMAIL=your-alt-user@example.com
DIDAXIS_ALT_PASSWORD=your-alt-password-here

# -----------------------------------------------------------------------------
# Agent / CI setup (not needed for `npx playwright test` alone)
# GitHub Actions: `.github/workflows/test-generation.yml` secrets.
# Local agents: Cursor settings / MCP for Atlassian; `CURSOR_API_KEY` for headless `agent` CLI.
# -----------------------------------------------------------------------------

# Cursor API key for the headless agent step in test-generation workflow.
CURSOR_API_KEY=your-cursor-api-key

# Atlassian Cloud API token (https://id.atlassian.com/manage-profile/security/api-tokens), not your login password.
ATLASSIAN_API_TOKEN=your-atlassian-api-token

# Jira site root URL (no trailing slash), e.g. for REST and MCP.
ATLASSIAN_BASE_URL=https://your-site.atlassian.net

# Email of the Atlassian account that owns the API token above.
ATLASSIAN_EMAIL=your-atlassian-email@example.com
