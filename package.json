{
  "name": "ai-assisted-qa-automation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "postinstall": "playwright install",
    "test": "playwright test",
    "test:didaxis": "playwright test features/DS-1.spec.ts features/DS-2.spec.ts features/DS-3.spec.ts features/DS-4.spec.ts features/DS-5.spec.ts --project=chromium",
    "test:a11y": "playwright test features/accessibility.spec.ts --project=chromium",
    "test:didaxis:cross-browser": "playwright test --config=playwright.ds1.config.ts --workers=1",
    "test:purge": "playwright test --config=playwright.manual.config.ts",
    "test:delete-programs": "playwright test --config=playwright.manual.config.ts",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:smoke": "playwright test --grep @smoke --pass-with-no-tests",
    "test:sanity": "playwright test --grep @sanity --pass-with-no-tests",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test --grep @api",
    "test:e2e": "playwright test --grep @e2e",
    "test:destructive": "playwright test --grep @destructive --workers=1",
    "report": "playwright show-report",
    "eval:report": "node scripts/generate-eval-report.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/risak7/ai-assisted-qa-automation.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/risak7/ai-assisted-qa-automation/issues"
  },
  "homepage": "https://github.com/risak7/ai-assisted-qa-automation#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3"
  },
  "dependencies": {
    "dotenv": "^18.0.4"
  }
}
